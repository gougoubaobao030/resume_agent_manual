{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "18000"
            ],
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "name": "Frontend Gradio",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/frontend/app.py",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Start Full Resume Agent",
            "configurations": [
                "Frontend Gradio",
                "Backend FastAPI"
            ],
            "stopAll": true
        }
    ]
}